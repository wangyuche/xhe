{
 "_meta": {
  "title": "Flux dev 文生圖(無負向提示詞)",
  "family": "flux",
  "params": {
   "unet": "Flux dev 檔名",
   "clip_l": "clip_l",
   "t5": "t5xxl",
   "vae": "ae",
   "guidance": "FluxGuidance",
   "prompt": "正向提示詞",
   "width": "寬",
   "height": "高",
   "seed": "seed",
   "steps": "steps",
   "sampler": "sampler",
   "scheduler": "scheduler"
  },
  "numeric": [
   "guidance",
   "width",
   "height",
   "seed",
   "steps"
  ]
 },
 "1": {
  "class_type": "UNETLoader",
  "inputs": {
   "unet_name": "{{unet}}",
   "weight_dtype": "default"
  }
 },
 "2": {
  "class_type": "DualCLIPLoader",
  "inputs": {
   "clip_name1": "{{clip_l}}",
   "clip_name2": "{{t5}}",
   "type": "flux",
   "device": "default"
  }
 },
 "3": {
  "class_type": "VAELoader",
  "inputs": {
   "vae_name": "{{vae}}"
  }
 },
 "6": {
  "class_type": "CLIPTextEncode",
  "inputs": {
   "clip": [
    "2",
    0
   ],
   "text": "{{prompt}}"
  }
 },
 "7": {
  "class_type": "FluxGuidance",
  "inputs": {
   "conditioning": [
    "6",
    0
   ],
   "guidance": "{{guidance}}"
  }
 },
 "8": {
  "class_type": "ConditioningZeroOut",
  "inputs": {
   "conditioning": [
    "6",
    0
   ]
  }
 },
 "9": {
  "class_type": "EmptySD3LatentImage",
  "inputs": {
   "width": "{{width}}",
   "height": "{{height}}",
   "batch_size": 1
  }
 },
 "10": {
  "class_type": "KSampler",
  "inputs": {
   "model": [
    "1",
    0
   ],
   "seed": "{{seed}}",
   "steps": "{{steps}}",
   "cfg": 1.0,
   "sampler_name": "{{sampler}}",
   "scheduler": "{{scheduler}}",
   "positive": [
    "7",
    0
   ],
   "negative": [
    "8",
    0
   ],
   "latent_image": [
    "9",
    0
   ],
   "denoise": 1.0
  }
 },
 "11": {
  "class_type": "VAEDecode",
  "inputs": {
   "samples": [
    "10",
    0
   ],
   "vae": [
    "3",
    0
   ]
  }
 },
 "12": {
  "class_type": "PreviewImage",
  "inputs": {
   "images": [
    "11",
    0
   ]
  }
 }
}
