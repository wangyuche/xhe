{
 "_meta": {
  "title": "Qwen-Image-Edit 參考圖 1 張(角色一致)+ 同一 workflow 本機去背(角色 sprite / 動作格)",
  "family": "qwen-image-edit",
  "params": {
   "unet": "diffusion model 檔名",
   "clip": "text encoder(Qwen2.5-VL)",
   "vae": "VAE",
   "lora": "LoRA 檔名(不用時填 none,lora_strength 仍要填一個數字)",
   "lora_strength": "LoRA 權重",
   "shift": "ModelSamplingAuraFlow shift",
   "prompt": "指示(英文;用 'the character in image 1' 指稱參考圖中的角色);要寫 plain flat light grey background, single subject, full body, centered,方便去背",
   "negative": "負向提示詞",
   "width": "寬",
   "height": "高",
   "seed": "seed",
   "steps": "steps",
   "cfg": "cfg",
   "sampler": "sampler",
   "scheduler": "scheduler",
   "ref1": "參考圖 1(upload 印出的 loadImage 名稱,例如 'x.png [temp]')",
   "bg_model": "RMBG 去背模型(check 的 background_removal[].models:RMBG-2.0 / INSPYRENET / BEN / BEN2)"
  },
  "numeric": [
   "lora_strength",
   "shift",
   "width",
   "height",
   "seed",
   "steps",
   "cfg"
  ],
  "output": "RGBA PNG(去背後的透明圖)"
 },
 "1": {
  "class_type": "UNETLoader",
  "inputs": {
   "unet_name": "{{unet}}",
   "weight_dtype": "default"
  }
 },
 "2": {
  "class_type": "CLIPLoader",
  "inputs": {
   "clip_name": "{{clip}}",
   "type": "qwen_image",
   "device": "default"
  }
 },
 "3": {
  "class_type": "VAELoader",
  "inputs": {
   "vae_name": "{{vae}}"
  }
 },
 "4": {
  "class_type": "LoraLoaderModelOnly",
  "inputs": {
   "model": [
    "1",
    0
   ],
   "lora_name": "{{lora}}",
   "strength_model": "{{lora_strength}}"
  }
 },
 "5": {
  "class_type": "ModelSamplingAuraFlow",
  "inputs": {
   "model": [
    "4",
    0
   ],
   "shift": "{{shift}}"
  }
 },
 "6": {
  "class_type": "CFGNorm",
  "inputs": {
   "model": [
    "5",
    0
   ],
   "strength": 1.0
  }
 },
 "8": {
  "class_type": "EmptySD3LatentImage",
  "inputs": {
   "width": "{{width}}",
   "height": "{{height}}",
   "batch_size": 1
  }
 },
 "21": {
  "class_type": "LoadImage",
  "inputs": {
   "image": "{{ref1}}"
  }
 },
 "31": {
  "class_type": "ImageScaleToTotalPixels",
  "inputs": {
   "image": [
    "21",
    0
   ],
   "upscale_method": "lanczos",
   "megapixels": 1.0,
   "resolution_steps": 1
  }
 },
 "40": {
  "class_type": "TextEncodeQwenImageEditPlus",
  "inputs": {
   "clip": [
    "2",
    0
   ],
   "prompt": "{{prompt}}",
   "vae": [
    "3",
    0
   ],
   "image1": [
    "31",
    0
   ]
  }
 },
 "41": {
  "class_type": "TextEncodeQwenImageEditPlus",
  "inputs": {
   "clip": [
    "2",
    0
   ],
   "prompt": "{{negative}}",
   "vae": [
    "3",
    0
   ],
   "image1": [
    "31",
    0
   ]
  }
 },
 "9": {
  "class_type": "KSampler",
  "inputs": {
   "model": [
    "6",
    0
   ],
   "seed": "{{seed}}",
   "steps": "{{steps}}",
   "cfg": "{{cfg}}",
   "sampler_name": "{{sampler}}",
   "scheduler": "{{scheduler}}",
   "positive": [
    "40",
    0
   ],
   "negative": [
    "41",
    0
   ],
   "latent_image": [
    "8",
    0
   ],
   "denoise": 1.0
  }
 },
 "10": {
  "class_type": "VAEDecode",
  "inputs": {
   "samples": [
    "9",
    0
   ],
   "vae": [
    "3",
    0
   ]
  }
 },
 "11": {
  "class_type": "PreviewImage",
  "inputs": {
   "images": [
    "14",
    0
   ]
  }
 },
 "12": {
  "class_type": "RMBG",
  "inputs": {
   "image": [
    "10",
    0
   ],
   "model": "{{bg_model}}",
   "sensitivity": 1.0,
   "process_res": 1024,
   "mask_blur": 0,
   "mask_offset": 0,
   "invert_output": false,
   "refine_foreground": true,
   "background": "Alpha",
   "background_color": "#222222"
  }
 },
 "13": {
  "class_type": "InvertMask",
  "inputs": {
   "mask": [
    "12",
    1
   ]
  }
 },
 "14": {
  "class_type": "JoinImageWithAlpha",
  "inputs": {
   "image": [
    "10",
    0
   ],
   "alpha": [
    "13",
    0
   ]
  }
 }
}
