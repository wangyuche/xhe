{
 "1": {
  "class_type": "UNETLoader",
  "inputs": {
   "unet_name": "{{unet}}",
   "weight_dtype": "default"
  }
 },
 "2": {
  "class_type": "CLIPLoader",
  "inputs": {
   "clip_name": "{{clip}}",
   "type": "lumina2",
   "device": "default"
  }
 },
 "3": {
  "class_type": "VAELoader",
  "inputs": {
   "vae_name": "{{vae}}"
  }
 },
 "5": {
  "class_type": "ModelSamplingAuraFlow",
  "inputs": {
   "model": [
    "1",
    0
   ],
   "shift": "{{shift}}"
  }
 },
 "6": {
  "class_type": "CLIPTextEncode",
  "inputs": {
   "clip": [
    "2",
    0
   ],
   "text": "{{prompt}}"
  }
 },
 "7": {
  "class_type": "ConditioningZeroOut",
  "inputs": {
   "conditioning": [
    "6",
    0
   ]
  }
 },
 "9": {
  "class_type": "KSampler",
  "inputs": {
   "model": [
    "12",
    0
   ],
   "seed": "{{seed}}",
   "steps": "{{steps}}",
   "cfg": "{{cfg}}",
   "sampler_name": "{{sampler}}",
   "scheduler": "{{scheduler}}",
   "positive": [
    "6",
    0
   ],
   "negative": [
    "7",
    0
   ],
   "latent_image": [
    "23",
    0
   ],
   "denoise": "{{denoise}}"
  }
 },
 "10": {
  "class_type": "VAEDecode",
  "inputs": {
   "samples": [
    "9",
    0
   ],
   "vae": [
    "3",
    0
   ]
  }
 },
 "11": {
  "class_type": "PreviewImage",
  "inputs": {
   "images": [
    "10",
    0
   ]
  }
 },
 "12": {
  "class_type": "DifferentialDiffusion",
  "inputs": {
   "model": [
    "5",
    0
   ]
  }
 },
 "21": {
  "class_type": "LoadImage",
  "inputs": {
   "image": "{{image}}"
  }
 },
 "22": {
  "class_type": "VAEEncode",
  "inputs": {
   "pixels": [
    "21",
    0
   ],
   "vae": [
    "3",
    0
   ]
  }
 },
 "23": {
  "class_type": "SetLatentNoiseMask",
  "inputs": {
   "samples": [
    "22",
    0
   ],
   "mask": [
    "21",
    1
   ]
  }
 },
 "_meta": {
  "title": "Z-Image 遮罩重畫(漸層遮罩,Differential Diffusion)",
  "family": "z-image",
  "params": {
   "unet": "Z-Image 檔名(check defaults.zimage_unet)",
   "clip": "Qwen3-4B text encoder(defaults.zimage_clip)",
   "vae": "ae(defaults.flux_vae)",
   "shift": "ModelSamplingAuraFlow shift(實測 3)",
   "image": "上傳的初始圖(upload 印出的 loadImage 名稱):透明的地方 = 要重畫,不透明 = 保留(actions.mjs init 產生)",
   "prompt": "正向提示詞(英文)",
   "seed": "seed",
   "steps": "steps(實測 8)",
   "cfg": "cfg(實測 1;負向用 ConditioningZeroOut,不吃負向提示詞)",
   "sampler": "sampler(實測 res_multistep)",
   "scheduler": "scheduler(實測 simple)",
   "denoise": "重畫程度 0–1(實測:身體 0.95、五官 0.7、整張輕改 0.55、補邊 0.9)"
  },
  "numeric": [
   "shift",
   "seed",
   "steps",
   "cfg",
   "denoise"
  ],
  "max": {
   "denoise": 1
  },
  "output": "整張 RGB(遮罩外也會被 VAE 重編碼;actions.mjs compose 把保留區貼回原圖像素)",
  "note": "遮罩灰階的地方只在最後幾步小改,接縫比較自然(延伸補邊、整張輕改用)"
 }
}
