{
 "_meta": {
  "title": "ACE-Step 1.5 配樂(本機,純音樂)",
  "family": "ace-step",
  "output": "音訊(PreviewAudio,下載後交 audio.mjs 處理)",
  "params": {
   "ckpt": "checkpoint 檔名(check 的 audio_models.bgm)",
   "tags": "風格標籤(英文,逗號分隔,例如 cozy, acoustic guitar, loopable game bgm)",
   "lyrics": "純音樂填 [instrumental]",
   "seconds": "長度(秒)",
   "bpm": "BPM",
   "timesignature": "拍號 2 / 3 / 4 / 6",
   "keyscale": "調性,例如 C major",
   "seed": "seed",
   "steps": "steps",
   "cfg": "KSampler cfg",
   "shift": "ModelSamplingAuraFlow shift",
   "sampler": "sampler",
   "scheduler": "scheduler"
  },
  "numeric": [
   "seconds",
   "bpm",
   "seed",
   "steps",
   "cfg",
   "shift"
  ]
 },
 "1": {
  "class_type": "CheckpointLoaderSimple",
  "inputs": {
   "ckpt_name": "{{ckpt}}"
  }
 },
 "2": {
  "class_type": "ModelSamplingAuraFlow",
  "inputs": {
   "model": [
    "1",
    0
   ],
   "shift": "{{shift}}"
  }
 },
 "3": {
  "class_type": "TextEncodeAceStepAudio1.5",
  "inputs": {
   "clip": [
    "1",
    1
   ],
   "tags": "{{tags}}",
   "lyrics": "{{lyrics}}",
   "seed": "{{seed}}",
   "bpm": "{{bpm}}",
   "duration": "{{seconds}}",
   "timesignature": "{{timesignature}}",
   "language": "en",
   "keyscale": "{{keyscale}}",
   "generate_audio_codes": true,
   "cfg_scale": 2.0,
   "temperature": 0.85,
   "top_p": 0.9,
   "top_k": 0,
   "min_p": 0.0
  }
 },
 "4": {
  "class_type": "ConditioningZeroOut",
  "inputs": {
   "conditioning": [
    "3",
    0
   ]
  }
 },
 "5": {
  "class_type": "EmptyAceStep1.5LatentAudio",
  "inputs": {
   "seconds": "{{seconds}}",
   "batch_size": 1
  }
 },
 "6": {
  "class_type": "KSampler",
  "inputs": {
   "model": [
    "2",
    0
   ],
   "seed": "{{seed}}",
   "steps": "{{steps}}",
   "cfg": "{{cfg}}",
   "sampler_name": "{{sampler}}",
   "scheduler": "{{scheduler}}",
   "positive": [
    "3",
    0
   ],
   "negative": [
    "4",
    0
   ],
   "latent_image": [
    "5",
    0
   ],
   "denoise": 1.0
  }
 },
 "7": {
  "class_type": "VAEDecodeAudio",
  "inputs": {
   "samples": [
    "6",
    0
   ],
   "vae": [
    "1",
    2
   ]
  }
 },
 "8": {
  "class_type": "PreviewAudio",
  "inputs": {
   "audio": [
    "7",
    0
   ]
  }
 }
}
