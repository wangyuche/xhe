{
 "_meta": {
  "title": "Qwen-Image + ControlNet Union(依草圖線條控制構圖)",
  "family": "qwen-image",
  "params": {
   "unet": "diffusion model 檔名",
   "clip": "text encoder(Qwen2.5-VL)",
   "vae": "VAE",
   "lora": "LoRA 檔名(不用時填 none,lora_strength 仍要填一個數字)",
   "lora_strength": "LoRA 權重",
   "shift": "ModelSamplingAuraFlow shift",
   "prompt": "正向提示詞",
   "negative": "負向提示詞",
   "width": "寬",
   "height": "高",
   "seed": "seed",
   "steps": "steps",
   "cfg": "cfg",
   "sampler": "sampler",
   "scheduler": "scheduler",
   "controlnet": "Qwen ControlNet Union 檔名",
   "control_image": "構圖草圖(upload 的 loadImage 名稱)",
   "control_strength": "ControlNet 強度(0.6–1.0)",
   "control_end": "ControlNet 作用到第幾成(0–1)"
  },
  "numeric": [
   "lora_strength",
   "shift",
   "width",
   "height",
   "seed",
   "steps",
   "cfg",
   "control_strength",
   "control_end"
  ]
 },
 "1": {
  "class_type": "UNETLoader",
  "inputs": {
   "unet_name": "{{unet}}",
   "weight_dtype": "default"
  }
 },
 "2": {
  "class_type": "CLIPLoader",
  "inputs": {
   "clip_name": "{{clip}}",
   "type": "qwen_image",
   "device": "default"
  }
 },
 "3": {
  "class_type": "VAELoader",
  "inputs": {
   "vae_name": "{{vae}}"
  }
 },
 "4": {
  "class_type": "LoraLoaderModelOnly",
  "inputs": {
   "model": [
    "1",
    0
   ],
   "lora_name": "{{lora}}",
   "strength_model": "{{lora_strength}}"
  }
 },
 "5": {
  "class_type": "ModelSamplingAuraFlow",
  "inputs": {
   "model": [
    "4",
    0
   ],
   "shift": "{{shift}}"
  }
 },
 "6": {
  "class_type": "CLIPTextEncode",
  "inputs": {
   "clip": [
    "2",
    0
   ],
   "text": "{{prompt}}"
  }
 },
 "7": {
  "class_type": "CLIPTextEncode",
  "inputs": {
   "clip": [
    "2",
    0
   ],
   "text": "{{negative}}"
  }
 },
 "20": {
  "class_type": "LoadImage",
  "inputs": {
   "image": "{{control_image}}"
  }
 },
 "21": {
  "class_type": "ImageScale",
  "inputs": {
   "image": [
    "20",
    0
   ],
   "upscale_method": "lanczos",
   "width": "{{width}}",
   "height": "{{height}}",
   "crop": "center"
  }
 },
 "22": {
  "class_type": "Canny",
  "inputs": {
   "image": [
    "21",
    0
   ],
   "low_threshold": 0.4,
   "high_threshold": 0.8
  }
 },
 "23": {
  "class_type": "ControlNetLoader",
  "inputs": {
   "control_net_name": "{{controlnet}}"
  }
 },
 "24": {
  "class_type": "SetUnionControlNetType",
  "inputs": {
   "control_net": [
    "23",
    0
   ],
   "type": "canny/lineart/anime_lineart/mlsd"
  }
 },
 "25": {
  "class_type": "ControlNetApplyAdvanced",
  "inputs": {
   "positive": [
    "6",
    0
   ],
   "negative": [
    "7",
    0
   ],
   "control_net": [
    "24",
    0
   ],
   "image": [
    "22",
    0
   ],
   "strength": "{{control_strength}}",
   "start_percent": 0.0,
   "end_percent": "{{control_end}}",
   "vae": [
    "3",
    0
   ]
  }
 },
 "8": {
  "class_type": "EmptySD3LatentImage",
  "inputs": {
   "width": "{{width}}",
   "height": "{{height}}",
   "batch_size": 1
  }
 },
 "9": {
  "class_type": "KSampler",
  "inputs": {
   "model": [
    "5",
    0
   ],
   "seed": "{{seed}}",
   "steps": "{{steps}}",
   "cfg": "{{cfg}}",
   "sampler_name": "{{sampler}}",
   "scheduler": "{{scheduler}}",
   "positive": [
    "25",
    0
   ],
   "negative": [
    "25",
    1
   ],
   "latent_image": [
    "8",
    0
   ],
   "denoise": 1.0
  }
 },
 "10": {
  "class_type": "VAEDecode",
  "inputs": {
   "samples": [
    "9",
    0
   ],
   "vae": [
    "3",
    0
   ]
  }
 },
 "11": {
  "class_type": "PreviewImage",
  "inputs": {
   "images": [
    "10",
    0
   ]
  }
 }
}
