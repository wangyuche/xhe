{
 "_meta": {
  "title": "Stable Audio 音效(本機)",
  "family": "stable-audio",
  "output": "音訊(PreviewAudio,下載後交 audio.mjs 處理)",
  "params": {
   "ckpt": "checkpoint 檔名(check 的 audio_models.sfx)",
   "clip": "text encoder(check 的 defaults.sfx_clip,CLIPLoader type stable_audio)",
   "prompt": "音效描述(英文)",
   "negative": "負向(例如 music, speech, noise)",
   "seconds": "生成長度(秒,比目標長一點,audio.mjs 再裁)",
   "seed": "seed",
   "steps": "steps",
   "cfg": "cfg",
   "sampler": "sampler",
   "scheduler": "scheduler"
  },
  "numeric": [
   "seconds",
   "seed",
   "steps",
   "cfg"
  ]
 },
 "1": {
  "class_type": "CheckpointLoaderSimple",
  "inputs": {
   "ckpt_name": "{{ckpt}}"
  }
 },
 "2": {
  "class_type": "CLIPTextEncode",
  "inputs": {
   "clip": [
    "9",
    0
   ],
   "text": "{{prompt}}"
  }
 },
 "3": {
  "class_type": "CLIPTextEncode",
  "inputs": {
   "clip": [
    "9",
    0
   ],
   "text": "{{negative}}"
  }
 },
 "4": {
  "class_type": "ConditioningStableAudio",
  "inputs": {
   "positive": [
    "2",
    0
   ],
   "negative": [
    "3",
    0
   ],
   "seconds_start": 0.0,
   "seconds_total": "{{seconds}}"
  }
 },
 "5": {
  "class_type": "EmptyLatentAudio",
  "inputs": {
   "seconds": "{{seconds}}",
   "batch_size": 1
  }
 },
 "6": {
  "class_type": "KSampler",
  "inputs": {
   "model": [
    "1",
    0
   ],
   "seed": "{{seed}}",
   "steps": "{{steps}}",
   "cfg": "{{cfg}}",
   "sampler_name": "{{sampler}}",
   "scheduler": "{{scheduler}}",
   "positive": [
    "4",
    0
   ],
   "negative": [
    "4",
    1
   ],
   "latent_image": [
    "5",
    0
   ],
   "denoise": 1.0
  }
 },
 "7": {
  "class_type": "VAEDecodeAudio",
  "inputs": {
   "samples": [
    "6",
    0
   ],
   "vae": [
    "1",
    2
   ]
  }
 },
 "8": {
  "class_type": "PreviewAudio",
  "inputs": {
   "audio": [
    "7",
    0
   ]
  }
 },
 "9": {
  "class_type": "CLIPLoader",
  "inputs": {
   "clip_name": "{{clip}}",
   "type": "stable_audio",
   "device": "default"
  }
 }
}
