{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "motion-video-kit/storyboard.schema.json",
 "title": "motion-video-kit storyboard(模板動畫模式的劇本)",
 "description": "render.mjs 先用這個 schema 驗證,不合結束碼 2。語意檢查(at 找得到、圖檔存在、focus 必填、同圖 ≤ 2 個場景、每句字數、姿勢存在、模板支援的場景類型)在 render.mjs。",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "scenes"
 ],
 "properties": {
  "template": {
   "type": "string",
   "minLength": 1,
   "description": "模板名稱或路徑(render.mjs 的 --template-dir 優先);沒寫 = github-hot-pastel"
  },
  "tag": {
   "type": "string",
   "minLength": 1,
   "maxLength": 16,
   "description": "左上標籤;沒寫用模板的 tag"
  },
  "scenes": {
   "type": "array",
   "minItems": 1,
   "maxItems": 40,
   "items": {
    "$ref": "#/$defs/scene"
   }
  }
 },
 "$defs": {
  "scene": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "headline",
    "lines"
   ],
   "properties": {
    "headline": {
     "type": "array",
     "minItems": 1,
     "maxItems": 2,
     "description": "1–2 行,每行 [黑字, 橘字](任一可為空字串)",
     "items": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
       {
        "type": "string",
        "maxLength": 14
       },
       {
        "type": "string",
        "maxLength": 14
       }
      ]
     }
    },
    "card": {
     "$ref": "#/$defs/card"
    },
    "mascot": {
     "type": "string",
     "pattern": "^[a-z0-9_-]+$",
     "description": "吉祥物姿勢(模板 template.json 的 mascot 鍵);沒寫 = base"
    },
    "lines": {
     "type": "array",
     "minItems": 1,
     "maxItems": 8,
     "items": {
      "$ref": "#/$defs/line"
     }
    }
   }
  },
  "line": {
   "anyOf": [
    {
     "type": "string",
     "minLength": 1,
     "maxLength": 80
    },
    {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "text"
     ],
     "properties": {
      "text": {
       "type": "string",
       "minLength": 1,
       "maxLength": 80
      },
      "say": {
       "type": "string",
       "minLength": 1,
       "maxLength": 120,
       "description": "TTS 念的文字(念法改寫)"
      }
     }
    }
   ]
  },
  "card": {
   "type": "object",
   "required": [
    "type"
   ],
   "properties": {
    "type": {
     "enum": [
      "image",
      "compare",
      "terminal",
      "chips",
      "checklist",
      "grid",
      "stat",
      "cta"
     ],
     "description": "沒有 card 的場景 = title"
    }
   },
   "allOf": [
    {
     "if": {
      "properties": {
       "type": {
        "const": "image"
       }
      }
     },
     "then": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "type",
       "src"
      ],
      "properties": {
       "type": {
        "const": "image"
       },
       "at": {
        "type": "string",
        "minLength": 1,
        "description": "在哪個分段詞出現(值 = 該場景 lines 裡某個分段詞,去掉 *);沒寫 = 場景開始時"
       },
       "src": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
       },
       "focus": {
        "type": "array",
        "items": {
         "type": "number",
         "minimum": 0
        },
        "minItems": 4,
        "maxItems": 4,
        "description": "來源像素 [x,y,w,h]"
       },
       "zoom": {
        "enum": [
         "in",
         "none"
        ]
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "type": {
        "const": "compare"
       }
      }
     },
     "then": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "type",
       "left",
       "right",
       "labels"
      ],
      "properties": {
       "type": {
        "const": "compare"
       },
       "at": {
        "type": "string",
        "minLength": 1,
        "description": "在哪個分段詞出現(值 = 該場景 lines 裡某個分段詞,去掉 *);沒寫 = 場景開始時"
       },
       "left": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
       },
       "right": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
       },
       "labels": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": {
         "type": "string",
         "minLength": 1,
         "maxLength": 14
        }
       },
       "focus": {
        "type": "array",
        "items": {
         "type": "number",
         "minimum": 0
        },
        "minItems": 4,
        "maxItems": 4,
        "description": "來源像素 [x,y,w,h]"
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "type": {
        "const": "terminal"
       }
      }
     },
     "then": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "type",
       "lines"
      ],
      "properties": {
       "type": {
        "const": "terminal"
       },
       "at": {
        "type": "string",
        "minLength": 1,
        "description": "在哪個分段詞出現(值 = 該場景 lines 裡某個分段詞,去掉 *);沒寫 = 場景開始時"
       },
       "lines": {
        "type": "array",
        "minItems": 1,
        "maxItems": 6,
        "items": {
         "type": "string",
         "minLength": 1,
         "maxLength": 48
        }
       },
       "typing": {
        "type": "boolean"
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "type": {
        "const": "chips"
       }
      }
     },
     "then": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "type",
       "items"
      ],
      "properties": {
       "type": {
        "const": "chips"
       },
       "at": {
        "type": "string",
        "minLength": 1,
        "description": "在哪個分段詞出現(值 = 該場景 lines 裡某個分段詞,去掉 *);沒寫 = 場景開始時"
       },
       "items": {
        "type": "array",
        "minItems": 1,
        "maxItems": 6,
        "items": {
         "type": "object",
         "additionalProperties": false,
         "required": [
          "text"
         ],
         "properties": {
          "text": {
           "type": "string",
           "minLength": 1,
           "maxLength": 24
          },
          "at": {
           "type": "string",
           "minLength": 1,
           "description": "在哪個分段詞出現(值 = 該場景 lines 裡某個分段詞,去掉 *);沒寫 = 場景開始時"
          }
         }
        }
       },
       "arrow": {
        "type": "boolean"
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "type": {
        "const": "checklist"
       }
      }
     },
     "then": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "type",
       "items"
      ],
      "properties": {
       "type": {
        "const": "checklist"
       },
       "at": {
        "type": "string",
        "minLength": 1,
        "description": "在哪個分段詞出現(值 = 該場景 lines 裡某個分段詞,去掉 *);沒寫 = 場景開始時"
       },
       "items": {
        "type": "array",
        "minItems": 1,
        "maxItems": 5,
        "items": {
         "type": "object",
         "additionalProperties": false,
         "required": [
          "text"
         ],
         "properties": {
          "text": {
           "type": "string",
           "minLength": 1,
           "maxLength": 24
          },
          "at": {
           "type": "string",
           "minLength": 1,
           "description": "在哪個分段詞出現(值 = 該場景 lines 裡某個分段詞,去掉 *);沒寫 = 場景開始時"
          }
         }
        }
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "type": {
        "const": "grid"
       }
      }
     },
     "then": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "type",
       "cols",
       "items"
      ],
      "properties": {
       "type": {
        "const": "grid"
       },
       "at": {
        "type": "string",
        "minLength": 1,
        "description": "在哪個分段詞出現(值 = 該場景 lines 裡某個分段詞,去掉 *);沒寫 = 場景開始時"
       },
       "cols": {
        "enum": [
         2,
         3
        ]
       },
       "items": {
        "type": "array",
        "minItems": 4,
        "maxItems": 6,
        "items": {
         "type": "object",
         "additionalProperties": false,
         "required": [
          "text"
         ],
         "properties": {
          "text": {
           "type": "string",
           "minLength": 1,
           "maxLength": 24
          },
          "at": {
           "type": "string",
           "minLength": 1,
           "description": "在哪個分段詞出現(值 = 該場景 lines 裡某個分段詞,去掉 *);沒寫 = 場景開始時"
          },
          "sub": {
           "type": "string",
           "minLength": 1,
           "maxLength": 16
          }
         }
        }
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "type": {
        "const": "stat"
       }
      }
     },
     "then": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "type",
       "value",
       "label"
      ],
      "properties": {
       "type": {
        "const": "stat"
       },
       "at": {
        "type": "string",
        "minLength": 1,
        "description": "在哪個分段詞出現(值 = 該場景 lines 裡某個分段詞,去掉 *);沒寫 = 場景開始時"
       },
       "value": {
        "type": "string",
        "minLength": 1,
        "maxLength": 10
       },
       "label": {
        "type": "string",
        "minLength": 1,
        "maxLength": 16
       },
       "icon": {
        "enum": [
         "star",
         "none"
        ]
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "type": {
        "const": "cta"
       }
      }
     },
     "then": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "type",
       "text"
      ],
      "properties": {
       "type": {
        "const": "cta"
       },
       "at": {
        "type": "string",
        "minLength": 1,
        "description": "在哪個分段詞出現(值 = 該場景 lines 裡某個分段詞,去掉 *);沒寫 = 場景開始時"
       },
       "text": {
        "type": "string",
        "minLength": 1,
        "maxLength": 14
       },
       "sub": {
        "type": "string",
        "minLength": 1,
        "maxLength": 40
       }
      }
     }
    }
   ]
  }
 }
}
